# Copy to .env and fill in real values from the Firebase console. Never commit .env.
# Example Environment Configuration Template for WestRoute Android App
FIREBASE_PROJECT_NAME=your_firebase_project_name
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PROJECT_NUMBER=your_firebase_project_number
FIREBASE_PUBLIC_FACING_NAME=your_firebase_public_facing_name
FIREBASE_ENVIRONMENT_TYPE=Unspecified

FIREBASE_ANDROID_APP_ID=your_firebase_android_app_id
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
APPLICATION_ID=your_application_id

FIREBASE_WEB_APP_ID=your_firebase_web_app_id
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

API_BASE_URL=your_api_base_url
MUNICIPAL_PORTAL_URL=your_municipal_portal_url

# OpenStreetMap & Geospatial Configuration (Open Source Map API)
OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_ATTRIBUTION=OpenStreetMap
CAMPUS_LAT=12.8230
CAMPUS_LNG=80.0440
CAMPUS_NAME=SRM IST Kattankulathur (SRM KTR)
